# Telegram
TELEGRAM_BOT_TOKEN=1234567890:replace_me

# Telegram ID пользователей через запятую.
# ВАЖНО: пользователь должен хотя бы один раз открыть бота и нажать /start,
# иначе Telegram не позволит боту первым отправить ему сообщение.
ALLOWED_TELEGRAM_IDS=111111111,222222222

# Wildberries: токены категории "Статистика"
WB_TOKEN_SPB_TT=replace_me
WB_TOKEN_SPB_TT_GROUP=replace_me

# Опционально: токены категории «Аналитика» для исторических остатков FBO/FBS.
# Если ваш основной Personal/Service токен уже включает «Аналитику», можно
# указать здесь тот же токен. Если оставить пустым, бот попробует основной токен.
WB_ANALYTICS_TOKEN_SPB_TT=
WB_ANALYTICS_TOKEN_SPB_TT_GROUP=

# Названия кабинетов в сообщениях
WB_NAME_SPB_TT=ООО «СПб-ТТ»
WB_NAME_SPB_TT_GROUP=ООО «СПБ-ТТ ГРУПП»

# SQLite
DB_PATH=data/bot.db

# Bothost: DB_PATH=/app/data/bot.db
# Первичная история Statistics; повторно весь период без необходимости не запрашивается.
WB_HISTORY_DAYS=90
WB_OPTIONAL_BUDGET_SECONDS=90
# Поиск включайте только при уже имеющихся правах/Джем. Подписки бот не покупает.
WB_ENABLE_SEARCH=false
WB_INITIAL_DAYS=15
# User confirmed personal Statistics tokens. Use base/unknown for other token types.
WB_STATISTICS_TOKEN_TYPE_SPB_TT=personal
WB_STATISTICS_TOKEN_TYPE_SPB_TT_GROUP=personal
WB_ENABLE_STOCK_HISTORY=true
# Отдельные токены при необходимости; иначе используется основной токен кабинета.
WB_CONTENT_TOKEN_SPB_TT=
WB_CONTENT_TOKEN_SPB_TT_GROUP=
WB_PRICES_TOKEN_SPB_TT=
WB_PRICES_TOKEN_SPB_TT_GROUP=
WB_ADS_TOKEN_SPB_TT=
WB_ADS_TOKEN_SPB_TT_GROUP=
# Переход к полному ZIP при большом XLSX (история не обрезается).
REPORT_MAX_CELLS=450000
REPORT_MAX_BYTES=47185920

# Часовой пояс отчётов
REPORT_TIMEZONE=Europe/Moscow

# Кэш данных WB в минутах.
# Нужен, чтобы несколько пользователей, запрашивающих отчёт рядом по времени,
# не расходовали лимиты Statistics API повторно.
WB_CACHE_MINUTES=20

# Таймаут HTTP-запроса
HTTP_TIMEOUT_SECONDS=60

# Пауза перед повтором после 429, если WB не прислал Retry-After
WB_429_FALLBACK_SECONDS=65
