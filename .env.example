# Telegram
TELEGRAM_BOT_TOKEN=1234567890:replace_me

# Telegram ID пользователей через запятую.
# ВАЖНО: пользователь должен хотя бы один раз открыть бота и нажать /start,
# иначе Telegram не позволит боту первым отправить ему сообщение.
ALLOWED_TELEGRAM_IDS=111111111,222222222

# Wildberries: токены категории "Статистика"
WB_TOKEN_SPB_TT=replace_me
WB_TOKEN_SPB_TT_GROUP=replace_me

# Названия кабинетов в сообщениях
WB_NAME_SPB_TT=ООО «СПб-ТТ»
WB_NAME_SPB_TT_GROUP=ООО «СПБ-ТТ ГРУПП»

# SQLite
DB_PATH=data/bot.db

# Часовой пояс отчётов
REPORT_TIMEZONE=Europe/Moscow

# Кэш данных WB в минутах.
# Нужен, чтобы несколько пользователей, запрашивающих отчёт рядом по времени,
# не расходовали лимиты Statistics API повторно.
WB_CACHE_MINUTES=20

# Таймаут HTTP-запроса
HTTP_TIMEOUT_SECONDS=60

# Пауза перед повтором после 429, если WB не прислал Retry-After
WB_429_FALLBACK_SECONDS=65
